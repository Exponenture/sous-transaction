# Copied to .env (repo root); read by backend/config/settings.py
DEBUG=true
SECRET_KEY=dev-insecure-change-me-to-a-long-random-string
# Local dev (make run-api). docker compose overrides this to point at the `db` service.
DATABASE_URL=postgres://sous:sous@localhost:5433/sous
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=
LOG_LEVEL=INFO
# Sentry (empty = disabled)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
# AI categorisation (empty = keyword rules only)
ANTHROPIC_API_KEY=
